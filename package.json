{
  "name": "dewlemend-macro",
  "version": "1.0.1",
  "description": "Dewlemend Makro Uygulamasi",
  "author": "Dewlemend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.dewlemend.makro",
    "productName": "Dewlemend Makro",
    "publish": {
      "provider": "github",
      "owner": "mc-efkar21",
      "repo": "REKOR-MAKROSU"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "^24.9.0",
    "electron-reload": "^1.2.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}